      {
        "name": "Medidas",
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "64213e8001eb461b9d203d7c9592ebf0"
          }
        ],
        "columns": [
          {
            "name": "Value",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "formatString": "0",
            "isDataTypeInferred": true,
            "isHidden": true,
            "isNameInferred": true,
            "lineageTag": "f4c3e5ea-1f44-4472-805b-b70339e59992",
            "sourceColumn": "[Value]",
            "summarizeBy": "sum",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "ae6b7272-a688-41a3-a061-85605fca46f1",
        "measures": [
          {
            "name": "Total de produções",
            "expression": "SUM('bi v_kpis_gerais'[total_producoes])",
            "formatString": "0",
            "lineageTag": "f52e32e3-0663-4c67-8ba4-b3d66fce621e"
          },
          {
            "name": "Pesquisadores com produção",
            "expression": "SUM('bi v_kpis_gerais'[pesquisadores_com_producao])",
            "formatString": "0",
            "lineageTag": "abf0b554-f11c-41c2-845c-08a5543c355d"
          },
          {
            "name": "Tópicos",
            "expression": "SUM('bi v_kpis_gerais'[topicos])",
            "formatString": "0",
            "lineageTag": "b64f4e5d-6a90-4271-8984-36a7c3a55cf2"
          },
          {
            "name": "Macrotemas",
            "expression": "SUM('bi v_kpis_gerais'[macrotemas])",
            "formatString": "0",
            "lineageTag": "bf502752-d15c-4974-b50a-ca35f7f59faa"
          },
          {
            "name": "Produções",
            "expression": "SUM('bi v_producao_ano_tipo'[qtd_producoes])",
            "formatString": "0",
            "lineageTag": "eccaf439-b90f-40c7-a918-127bbf441607"
          },
          {
            "name": "Pesquisadores por ano",
            "expression": "SUM ('bi v_pesquisadores_ano'[qtd_pesquisadores])",
            "formatString": "0",
            "lineageTag": "6d1d0a61-793b-4453-8b7c-91bf78179711"
          },
          {
            "name": "Produções por grande área",
            "expression": "SUM('bi v_producao_grande_area_ano'[qtd_producoes])",
            "formatString": "0",
            "lineageTag": "abdf42d3-df1e-49bf-8b60-0f1b90ecb696"
          },
          {
            "name": "Produções por macrotema",
            "expression": "SUM('bi v_macrotema_ano_tipo'[qtd_producoes])",
            "formatString": "0",
            "lineageTag": "12aa4664-dc37-4f07-a953-cd7664f3e58e"
          },
          {
            "name": "Participação do macrotema",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "DIVIDE(",
              "[Produções por macrotema],",
              "CALCULATE( [Produções por macrotema], ALL('bi v_macrotema_ano_tipo'[macrotema])",
              "))"
            ],
            "lineageTag": "46c5d3b7-c61b-4dbe-85d2-fa4590ae927e"
          },
          {
            "name": "% tópico aproximado",
            "expression": [
              "DIVIDE(",
              "SUM('bi v_qualidade_classificacao'[qtd_topico_aproximado]),",
              "SUM('bi v_qualidade_classificacao'[qtd_producoes])",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "eb543b4e-d5a5-4709-8c04-eb8c68a1e0cb"
          },
          {
            "name": "% sem tema",
            "expression": [
              "DIVIDE(",
              "SUM('bi v_qualidade_classificacao'[qtd_sem_tema]),",
              "SUM('bi v_qualidade_classificacao'[qtd_producoes])",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "4eec1d9f-f64a-42a9-8786-7a38f86d8b8e"
          },
          {
            "name": "Produções por país",
            "expression": [
              "CALCULATE(",
              "SUM('bi v_pais_ano_tipo'[qtd_producoes]),",
              "'bi v_pais_ano_tipo'[pais] <> \"Não informado\"",
              "",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "16433e53-251c-4384-875a-40db2c8d343b"
          },
          {
            "name": "% fora do Brasil",
            "expression": [
              "DIVIDE(",
              "CALCULATE(",
              "    SUM( 'bi v_pais_ano_tipo'[qtd_producoes]), ",
              "    'bi v_pais_ano_tipo'[fora_do_brasil] = TRUE()",
              "),",
              "[Produções por país]",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "60b0fb4d-636d-4ac6-aa07-5c5b06f1d1a1"
          },
          {
            "name": "Itens",
            "expression": "SUM( 'bi v_obras_distintas'[qtd_itens])",
            "formatString": "0",
            "lineageTag": "7e1b8bab-53dd-4195-b730-34f5dc02fd1f"
          },
          {
            "name": "Obras distintas",
            "expression": "SUM( 'bi v_obras_distintas'[qtd_obras_distintas])",
            "formatString": "0",
            "lineageTag": "f3601799-18c2-4678-af12-30f344c5d05a"
          },
          {
            "name": "Razão itens/obras",
            "expression": [
              "DIVIDE(",
              "[Itens],",
              "[Obras distintas]",
              ")"
            ],
            "formatString": "0.00",
            "lineageTag": "c6355c8f-f024-480b-a52e-ff2947684895"
          },
          {
            "name": "Pesquisadores por área",
            "expression": "SUM( 'bi v_pesquisadores_area'[qtd_pesquisadores])",
            "formatString": "0",
            "lineageTag": "3ea15ab3-e916-4be0-96df-1d971e2804b8"
          },
          {
            "name": "% classificado diretamente",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "1 - [% tópico aproximado] - [% sem tema]",
            "lineageTag": "5269258d-c85a-4d2a-a5b2-5bdfa4726d68"
          }
        ],
        "partitions": [
          {
            "name": "Medidas",
            "mode": "import",
            "source": {
              "expression": "{ BLANK()}",
              "type": "calculated"
            }
          }
